# Copy to .env and fill in the key for the provider you use. .env is ignored by git.
# The Makefile loads .env when it exists; by hand:  uv run --env-file .env <script>
# If both keys are set, OpenRouter is used.

# OpenRouter (the path this submission was run and tested on). Calls go to
# https://openrouter.ai/api/v1 and MODEL is an OpenRouter id such as openai/gpt-6-luna.
OPENROUTER_API_KEY=

# OpenAI direct: used when OPENROUTER_API_KEY is empty. MODEL is an OpenAI model id.
# This path is covered by mocked tests only; it has not been run live.
OPENAI_API_KEY=

# Where run_baseline.py saves what the reader returned for each case, so the run can be
# re-scored later without another model call. Remove the line to save nothing.
TRIAGE_FACTS_DIR=data/reader_facts
