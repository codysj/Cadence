# Copy to .env and fill in ONE key. .env is ignored by git.
# Load it with:  uv run --env-file .env <script>

# OpenRouter: when set, calls go to https://openrouter.ai/api/v1 and MODEL must be
# an OpenRouter id such as openai/gpt-6-luna.
OPENROUTER_API_KEY=

# OpenAI direct: used when OPENROUTER_API_KEY is empty.
OPENAI_API_KEY=
