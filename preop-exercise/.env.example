# Copy to .env and fill in the key for the provider you use. .env is ignored by git.
# The Makefile loads .env when it exists; by hand:  uv run --env-file .env <script>
# If both keys are set, OpenRouter is used.

# OpenRouter: calls go to https://openrouter.ai/api/v1 and MODEL must be an
# OpenRouter id such as openai/gpt-6-luna.
OPENROUTER_API_KEY=

# OpenAI direct: used when OPENROUTER_API_KEY is empty. MODEL is an OpenAI id.
OPENAI_API_KEY=
